  Task:
Store multiple students
Ask user to enter name
Show marks if found

  code-

  students = {
    "Swaroop": [80, 90, 85],
    "Ravi": [70, 60, 75],
    "Anil": [90, 95, 92]
}

name = input("Enter student name: ")

if name in students:
    marks = students[name]
    print("Marks:", marks)
    print("Total:", sum(marks))
    print("Average:", sum(marks)/len(marks))
else:
    print("Student not found")

  OUTPUT-
  Enter student name: Swaroop
Marks: [80, 90, 85]
Total: 255
Average: 85.0


  Types of Statements
  
Assignment Statement (Used to store values)
 Conditional Statements (Used for decision making)
. Loop Statements (Used for repeating code)
  . Control Statements (Used to control loop flow)
  Input/Output (Statements Take input and show output)

  students = {}

# Input statement + loop
for i in range(3):
    name = input("Enter student name: ")
    
    marks = []
    for j in range(3):
        m = int(input("Enter marks: "))
        marks.append(m)
    
    students[name] = marks   # assignment

# Processing
for name in students:
    total = sum(students[name])
    avg = total / 3

    print("Name:", name)
    print("Marks:", students[name])
    print("Total:", total)
    print("Average:", avg)

    # Conditional statement
    if avg >= 90:
        print("Grade: A")
    elif avg >= 75:
        print("Grade: B")
    elif avg >= 50:
        print("Grade: C")
    else:
        print("Grade: Fail")

    print("------")

